{
  "name": "goteborg-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Göteborg public transport (Västtrafik buses and trams) — Trafiklab GTFS Regional + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=10240 pipeline/build.mjs --all --tram all",
    "lines": "node --max-old-space-size=8192 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=8192 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8165"
  }
}
